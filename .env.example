# Copie para .env e ajuste. O .env NÃO é versionado.

# Data do aniversário (MM-DD). Aparece no documento e no contador regressivo.
BIRTHDAY=01-01

# Passphrase que protege a chave privada PGP do servidor no disco.
# Se definir depois que a chave já existe, ela é protegida no próximo start.
SERVER_KEY_PASSPHRASE=

# Identidade da chave do servidor (aparece no recibo PGP)
SERVER_KEY_NAME=Assinador de Documentos (Servidor)
SERVER_KEY_EMAIL=assinador@localhost

# Pasta onde ficam signatures.db e server_key.asc (padrão: pasta do app)
# DATA_DIR=./data

# Tentativas de assinatura por IP por minuto
RATE_LIMIT_PER_MINUTE=5

# Servidor de desenvolvimento
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
